# Токен бота от @BotFather
BOT_TOKEN=
# Тревоги работают и без ключей (зеркало siren.pp.ua). Ключи по желанию:
# официальный API «Повітряна тривога»: https://api.ukrainealarm.com
UKRAINEALARM_TOKEN=
# alerts.in.ua: https://devs.alerts.in.ua
ALERTS_TOKEN=
# ALERTS_SOURCE=ukrainealarm|alertsinua|mirror   # или кнопкой в боте: Налаштування → Джерело тривог
# ADMIN_IDS=123456789   # кто может менять источник; пусто — первый, кто напишет /source в личке

# Необязательно:
# ALERTS_POLL_SECONDS=30   # с ukrainealarm бот сам опрашивает раз в UKRAINEALARM_POLL_SECONDS=60
# POWER_POLL_SECONDS=600
# DEFAULT_REMIND=30
# DEFAULT_SUMMARY=07:00   # утренняя сводка по умолчанию; пусто — выключена
# ALERT_LOG_DAYS=31   # сколько дней хранить журнал тревог для /stats
# POSSIBLE_AS_OFF=1   # "можливе відключення" считать отключением

# Резервная копия базы раз в сутки: data/backups + файл владельцу бота в Telegram
# BACKUP_HOUR=4        # час по Киеву, -1 — выключить
# BACKUP_KEEP=14       # сколько копий хранить на сервере
# BACKUP_TELEGRAM=1    # 0 — не отправлять файл в Telegram
